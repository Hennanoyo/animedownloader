{
  "name": "AnimeDownloader",
  "dockerComposeFile": [
    "../compose.yaml",
    "docker-compose.devcontainer.yml"
  ],
  "service": "dev",
  "runServices": [
    "dev",
    "api",
    "web",
    "worker",
    "db",
    "redis",
    "storage"
  ],
  "workspaceFolder": "/app",
  "remoteUser": "node",
  "shutdownAction": "stopCompose",
  "forwardPorts": [5173, 8000, 5432, 6379, 8888],
  "postCreateCommand": "uv sync --all-packages --project /app/server && cd /app/web && pnpm install",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "dbaeumer.vscode-eslint"
      ]
    }
  }
}
